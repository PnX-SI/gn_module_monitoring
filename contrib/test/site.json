{
  "display_properties": [
    "id_sites_group",
    "base_site_name",
    "base_site_code",
    "base_site_description",
    "id_nomenclature_type_site",
    "cd_hab",
    "id_inventor",
    "first_use_date",
    "last_visit",
    "nb_visits"
  ],
  "display_list": [
    "base_site_name",
    "commune_areas",
    "commune_area_code",
    "commune"
  ],
  "export_pdf": [
    {
        "template": "fiche_site.html",
        "label": "Export PDF"
    }
  ],
  "map_label_field_name": "base_site_name",
  "geometry_type": "Point",
  "specific": {
    "base_site_code": {
      "required": false
    },
    "id_nomenclature_type_site": {
      "filters": {
        "cd_nomenclature": ["1", "2", "3"]
      },
      "default": {
        "cd_nomenclature": "1"
      }
    },
    "id_sites_group": {
      "required": true,
      "hidden": false
    },
    "contact_name": {
      "type_widget": "text",
      "attribut_label": "contact"
    },
    "profondeur_grotte": {
      "type_widget": "number",
      "attribut_label": "Profondeur de la grotte",
      "hidden": "({value, meta}) => {return (meta.nomenclatures[value.id_nomenclature_type_site] || {}).cd_nomenclature !== '1'}"
    },
    "cd_hab": {
      "type_widget": "datalist",
      "attribut_label": "Habitat",
      "api": "habref/habitats/autocomplete",
      "application": "GeoNature",
      "keyValue": "cd_hab",
      "keyLabel": "search_name",
      "type_util": "habitat",
      "params": {
          "cd_typo": 7,
          "search_name": ""
      }
    },
    "meteo": {
      "type_widget": "nomenclature",
      "attribut_label": "test météo",
      "code_nomenclature_type": "TEST_METEO",
      "type_util": "nomenclature",
      "required": false
    },
    "meteo_multiple": {
      "type_widget": "nomenclature",
      "attribut_label": "test météo multiple",
      "code_nomenclature_type": "TEST_METEO",
      "type_util": "nomenclature",
      "required": false,
      "multiple": true
    },
    "multiselect": {
      "type_widget": "multiselect",
      "attribut_label": "Multiselect",
      "values": [
        "choix_1",
        "choix_2",
        "choix_3"
      ]
    },
    "cd_nom_taxonomy": {
      "type_widget": "taxonomy",
      "attribut_label": "Taxonomy",
      "id_list": "100",
      "type_util": "taxonomy"
    },
    "uuid_test": {
      "attribut_label": "uuid test",
      "type_widget": "text",
      "type_util": "uuid"
    },
    "determiner": {
      "type_widget": "observers",
      "attribut_label": "Observateur",
      "type_util": "user",
      "code_list": "CODE_OBSERVERS_LIST",
      "multi_select": false
    },
    "determiner_mutiple": {
      "type_widget": "observers",
      "attribut_label": "Observateur",
      "type_util": "user",
      "code_list": "CODE_OBSERVERS_LIST",
      "multi_select": true
    },
    "commune_areas": {
      "type_widget": "areas",
      "attribut_label": "Commune area",
      "type_util": "area",
      "type_codes": ["COM"],
      "multiple": false,
      "required": false
  },
    "commune_aa": {
      "type_widget": "municipalities",
      "attribut_label": "Commune municipality",
      "type_util": "area",
      "type_codes": ["COM"],
      "multiple": false,
      "required": false
  },
  "commune_area_code": {
      "type_widget": "municipalities",
      "attribut_label": "Commune area code",
      "value_field_name": "area_code",
      "type_util": "area",
      "multiple": false,
      "required": false
    }
  }
}
